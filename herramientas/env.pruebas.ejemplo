# Copie este archivo como ".env.pruebas" (junto a main.py) y complete con los datos del
# proyecto de PRUEBAS de Supabase (Settings > API Keys). NUNCA ponga aquí datos de producción.
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
# Llave pública (publishable / anon) del proyecto de pruebas: el PC trabajará con sesión de usuario
SUPABASE_KEY=sb_publishable_XXXXXXXXXXXXXXXX
# Opcional: la misma de producción si quiere probar la lectura con IA
GEMINI_API_KEY=
